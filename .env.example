# Gemini is the answer-generation primary; Groq is its automatic fallback.
PRIMARY_LLM=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GROQ_API_KEY=YOUR_GROQ_API_KEY
GEMINI_MODEL=gemini-3.6-flash
GROQ_MODEL=openai/gpt-oss-120b

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=your_username
NEO4J_PASSWORD=your_password

CHROMA_HOST=localhost
CHROMA_PORT=8001

# Required for the local demo. Keep this value out of source control.
DEMO_API_KEY=replace-with-a-long-random-value
DEMO_USER_ID=E0001

REDIS_URL=redis://localhost:6379/0
CONVERSATION_TTL_SECONDS=86400
MAX_CONCURRENT_REQUESTS=8
REQUEST_QUEUE_TIMEOUT_SECONDS=2

# Routing logs contain counts, field names, and content hashes by default.
# Set true only for local debugging when full prompt/context content is safe.
DEBUG_ROUTING_CONTENT=false

# Developer-only memory pipeline traces. Never enable this for production data:
# traces contain original user messages and extraction output.
EXTRACTION_TRACE=false
EXTRACTION_TRACE_DIRECTORY=logs/extraction
CANONICAL_FACTS_ENABLED=true
# Keep the graph small while developing.  Manual sync remains available via
# `python scripts/sync_enterprise_facts.py` inside the worker container.
ENABLE_ENTERPRISE_SYNC=false
# Set true only when the markdown company-policy seed data is wanted.
ENABLE_COMPANY_POLICY_SEED=false
ENTERPRISE_SYNC_INTERVAL_SECONDS=86400

# Version 2 persistent user-profile learning. Candidate observations remain in
# Redis; only promoted preferences are written into the canonical graph.
PROFILE_LEARNING_ENABLED=true
PROFILE_MIN_DISTINCT_SESSIONS=3
PROFILE_SIGNAL_WINDOW_DAYS=90
PROFILE_SIGNAL_RETENTION_BUFFER_DAYS=7
PROFILE_POLICY_VERSION=v2
PROFILE_JOB_MAX_ATTEMPTS=4

# This refreshes only fields that an authenticated user previously requested.
# It never triggers a full enterprise import.
ENTERPRISE_ON_DEMAND_CACHE_ENABLED=true
ENTERPRISE_CACHE_REFRESH_INTERVAL_SECONDS=86400
ENTERPRISE_CACHE_MAX_STALE_SECONDS=172800

# Local performance diagnostics: terminal summaries per operation and rolling
# JSON Lines reports under ./logs (mounted from the host by docker-compose).
PERFORMANCE_INSTRUMENTATION_ENABLED=true
PERFORMANCE_SUMMARY_INTERVAL_SECONDS=300
PERFORMANCE_SUMMARY_DIRECTORY=logs
PERFORMANCE_SAMPLE_LIMIT=2000
PERFORMANCE_REPORT_RETENTION_DAYS=14
